{
  "name": "blackroad-mobile",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "eas-build": "eas build",
    "eas-submit": "eas submit",
    "lint": "eslint App.js gesture-handler*.js src --ext .js --max-warnings 0",
    "export:check": "expo export --platform android --platform ios --max-workers 2",
    "check:dependencies": "expo install --check"
  },
  "dependencies": {
    "expo": "^49.0.0",
    "expo-status-bar": "~1.6.0",
    "react": "18.2.0",
    "react-native": "0.72.10",
    "react-native-gesture-handler": "~2.12.0",
    "@react-navigation/native": "^6.1.7",
    "@react-navigation/bottom-tabs": "^6.5.8",
    "@react-navigation/stack": "^6.3.16",
    "axios": "^1.4.0",
    "react-native-svg": "13.9.0",
    "victory-native": "^36.5.0",
    "@react-native-async-storage/async-storage": "1.18.2",
    "react-native-screens": "~3.22.0",
    "react-native-safe-area-context": "4.6.3",
    "@expo/vector-icons": "^13.0.0",
    "expo-notifications": "~0.20.1",
    "expo-build-properties": "~0.8.3"
  },
  "devDependencies": {
    "@babel/core": "^7.22.0",
    "@types/react": "~18.2.14",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "babel-preset-expo": "~9.5.2"
  },
  "expo": {
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 33
          },
          "ios": {
            "deploymentTarget": "13.0"
          }
        }
      ]
    ]
  },
  "main": "node_modules/expo/AppEntry.js"
}
